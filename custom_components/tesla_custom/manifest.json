{
  "domain": "tesla_custom",
  "name": "Tesla Custom Integration",
  "after_dependencies": ["mqtt"],
  "codeowners": ["@martinsaul"],
  "config_flow": true,
  "dependencies": ["http"],
  "dhcp": [
    {
      "hostname": "tesla_*",
      "macaddress": "4CFCAA*"
    },
    {
      "hostname": "tesla_*",
      "macaddress": "044EAF*"
    },
    {
      "hostname": "tesla_*",
      "macaddress": "98ED5C*"
    }
  ],
  "documentation": "https://github.com/martinsaul/teslahacs",
  "import_executor": true,
  "iot_class": "cloud_polling",
  "issue_tracker": "https://github.com/martinsaul/teslahacs/issues",
  "loggers": ["tesla_custom"],
  "requirements": ["httpx>=0.24.0", "async-timeout>=4.0.0"],
  "version": "4.0.1"
}
